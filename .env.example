# Storefront 설정 안내 — 실제 키는 .env.local / .env.production.local에만 보관합니다.
# Vercel Preview/Production은 별도 등록. 자세한 기준: docs/environment-isolation.md

# 1. 기본 연결 — 로컬 개발은 프론트 3001 / Admin 3003
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3003
# Protected Admin Vercel Preview only: its automation bypass key, server-only.
# Localhost/unprotected Production do not need this variable.
# ADMIN_API_PROTECTION_BYPASS=
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-public-storefront-token
# Shopify Admin API용 서버 전용 앱 키 (공개 Storefront 토큰과 별개)
SHOPIFY_CLIENT_ID=your-app-client-id
SHOPIFY_CLIENT_SECRET=your-app-client-secret
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key

# 2. 판매 정책 — Vercel 환경과 별개. 개발 Shopify의 구매 시험에는 live 사용 가능.
NEXT_PUBLIC_STORE_LAUNCH_STATUS=preview
NEXT_PUBLIC_CANCEL_WINDOW_HOURS=3

# 3. 캐시 갱신 — 같은 환경 Admin의 값과 일치. 운영/시험 키는 분리.
REVALIDATE_SECRET=

# 4. 예약 작업을 사용할 때 (호출자 Bearer 값과 일치)
# CRON_SECRET=

# 5. 메일 기능을 사용할 때
# RESEND_API_KEY=
# UNSUBSCRIBE_SECRET=
# 공급자의 해당 webhook endpoint Signing secret. API key나 임의 값으로 대체하지 않습니다.
# RESEND_WEBHOOK_SECRET=
# 기존 운영 수신거부 링크를 폐기할 때만 false. Preview에서는 코드가 이미 구형 링크를 차단합니다.
# UNSUBSCRIBE_ACCEPT_LEGACY=false

# 6. 선택 기능 — 현재 앱에 CrispChat을 렌더링하는 경우에만 필요
# NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ADMIN_API_URL / SHOPIFY_STORE_DOMAIN / SHOPIFY_STOREFRONT_ACCESS_TOKEN은 더 이상 읽지 않습니다.
# 문의 실시간/메일 활성화 플래그는 Admin 프로젝트에서 관리합니다.
