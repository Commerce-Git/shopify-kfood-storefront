# Local storefront (npm run dev: port 3001). Vercel Preview needs its own fixed HTTPS origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3003

# Use matching domain/public Storefront token from the selected Shopify store.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-public-storefront-token
# Server-only Admin API credentials; one app may be installed in both stores.
SHOPIFY_CLIENT_ID=your-app-client-id
SHOPIFY_CLIENT_SECRET=your-app-client-secret

# All three must belong to the same Supabase project as this environment's Admin.
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# Unique to this environment; never use NEXT_PUBLIC_ for secrets.
UNSUBSCRIBE_SECRET=
UNSUBSCRIBE_ACCEPT_LEGACY=false
REVALIDATE_SECRET=
CRON_SECRET=
# Enable email only with test recipients configured; this is not an automatic sandbox.
RESEND_API_KEY=

# This controls purchasing, independently of Vercel Production/Preview.
# Set live for checkout testing only after the dev Shopify connection is verified.
NEXT_PUBLIC_STORE_LAUNCH_STATUS=preview
